<%- include('partials/head') %>
<div class="container form-card narrow">
  <div class="card card-pad">
    <div class="center"><img src="<%= site.logo %>" alt="" style="height:80px;width:80px;padding:8px;border-radius:18px;background:var(--brand);margin:0 auto 8px"></div>
    <h1 class="center" style="font-size:1.6rem">เข้าสู่ระบบ</h1>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field"><label for="u">ชื่อผู้ใช้</label><input type="text" id="u" name="username" value="<%= username %>" autocapitalize="none" autocomplete="username" required autofocus></div>
      <div class="field"><label for="p">รหัสผ่าน</label><input type="password" id="p" name="password" autocomplete="current-password" required></div>
      <button class="btn btn-primary btn-block">เข้าสู่ระบบ</button>
    </form>
    <p class="center small muted" style="margin-top:16px">ยังไม่มีบัญชี? <a href="/register">สมัครสมาชิก</a><br>ลืมรหัสผ่าน? ติดต่อสถาบันทาง LINE <%= site.contactLine %></p>
  </div>
</div>
<%- include('partials/foot') %>
