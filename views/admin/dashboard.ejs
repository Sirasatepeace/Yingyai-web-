<%- include('../partials/head') %>
<div class="container admin-wrap">
  <%- include('_nav') %>
  <div>
    <h1 style="font-size:1.6rem">ภาพรวม</h1>
    <div class="kpis">
      <a class="kpi <%= counts.pendingUsers ? 'alert-kpi' : '' %>" href="/admin/users?status=pending"><b><%= counts.pendingUsers %></b>สมาชิกรออนุมัติ</a>
      <a class="kpi <%= counts.pendingPayments ? 'alert-kpi' : '' %>" href="/admin/payments"><b><%= counts.pendingPayments %></b>การชำระเงินรอตรวจ</a>
      <div class="kpi"><b><%= counts.students %></b>นักเรียนทั้งหมด</div>
      <div class="kpi"><b><%= counts.courses %></b>คอร์ส</div>
      <div class="kpi"><b><%= counts.enrollments %></b>การลงทะเบียน</div>
      <div class="kpi"><b>฿<%= counts.revenue.toLocaleString('th-TH') %></b>รายได้ที่อนุมัติแล้ว</div>
    </div>
    <div class="section-head"><h2 style="font-size:1.2rem">สมัครล่าสุด</h2><a href="/admin/users?status=all">ดูทั้งหมด →</a></div>
    <div class="table-wrap"><table>
      <tr><th>ชื่อ</th><th>ชั้น</th><th>โรงเรียน</th><th>สถานะ</th><th>สมัครเมื่อ</th></tr>
      <% recent.forEach(function (u) { %>
        <tr><td><%= u.first_name %> <%= u.last_name %> (<%= u.nickname %>)<div class="small muted">@<%= u.username %></div></td><td><%= u.grade %></td><td><%= u.school_input %></td>
        <td><span class="badge <%= u.status === 'active' ? 'badge-success' : u.status === 'pending' ? 'badge-warning' : 'badge-danger' %>"><%= { active: 'ใช้งานได้', pending: 'รออนุมัติ', rejected: 'ปฏิเสธ' }[u.status] %></span></td><td class="small"><%= u.created_at %></td></tr>
      <% }) %>
      <% if (!recent.length) { %><tr><td colspan="5" class="muted center">ยังไม่มีสมาชิก</td></tr><% } %>
    </table></div>
  </div>
</div>
<%- include('../partials/foot') %>
